# Supabase Configuration
# 1. supabase.com pe free project banao
# 2. Project Settings -> API -> yahan se URL aur anon key copy karo
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role (sirf server side ke liye, client me mat daalo)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth will auto-work once you enable it in:
# Supabase Dashboard -> Authentication -> Providers -> Google -> Enable
# Google Cloud Console se Client ID / Secret daalna hoga (5 min ka kaam)
